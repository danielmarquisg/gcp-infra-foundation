# Dependencias descargadas y configuración local generada por Terraform
**/.terraform/*

# El estado puede contener IDs, IPs, metadatos y secretos
*.tfstate
*.tfstate.*

# Valores del entorno; conservamos los ejemplos para documentar cómo configurarlos
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Configuración local del backend con el nombre real del bucket
backend.hcl
*.backend.hcl

# Los planes guardados pueden incluir valores sensibles; los logs son diagnósticos locales
*.tfplan
*.plan
tfplan
crash.log
crash.*.log

# Configuración local de la CLI y archivos que sobrescriben la configuración Terraform
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credenciales y claves privadas
*.pem
*.key
*credentials*.json
*service-account*.json

# Archivos del editor y del sistema operativo
.DS_Store
.idea/
.vscode/
*.swp

# .terraform.lock.hcl sí se versiona para compartir versiones y hashes de los providers.
# Ignorar un archivo no elimina versiones que ya se hayan guardado en Git.
