# root terraform.tfvars
#
# Copia este archivo como terraform.tfvars y configura el ID de tu proyecto.
# terraform.tfvars está excluido de Git y no debe contenerse en un commit.

project_id = "your-gcp-project-id"
region     = "europe-west1"
zone       = "europe-west1-b"
# Si cambias la región, elige también una zona que pertenezca a ella.

# --- Red (Subnets) ---
# frontend/backend son claves usadas por main.tf; name es el nombre visible en GCP.
subnets = {
  frontend = {
    name = "subnet-frontend"
    cidr = "10.10.10.0/24"
  }
  backend = {
    name = "subnet-backend"
    cidr = "10.10.20.0/24"
  }
}

# --- Seguridad (Firewall) ---
# Reglas de entrada para las futuras VMs privadas del MIG.
ingress_rules_list = [
  # IAP permite diagnosticar una VM sin asignarle una IP pública.
  {
    name          = "allow-ssh-iap"
    description   = "Acceso SSH seguro mediante Google IAP"
    source_ranges = ["35.235.240.0/20"] # Rango oficial de Google IAP
    target_tags   = ["workspace-web-backend"]
    protocol      = "tcp"
    ports         = ["22"]
  },

  # Solo los proxies y health checks de Google pueden alcanzar Nginx en las VMs.
  {
    name          = "allow-load-balancer-to-web"
    description   = "Tráfico HTTP del balanceador y sus health checks"
    source_ranges = ["35.191.0.0/16", "130.211.0.0/22"]
    target_tags   = ["workspace-web-backend"]
    protocol      = "tcp"
    ports         = ["80"]
  }
]

# No añadimos una regla redundante: GCP ya permite la salida de forma implícita.
# Las reglas de firewall no proporcionan NAT a una VM privada.
egress_rules_list = []
